{
  "name": "@seshuk/payload-plugin-media-preview",
  "version": "2.0.0-beta.1",
  "description": "Payload plugin for previewing images, videos, audio, and documents in the admin panel",
  "keywords": [
    "audio",
    "cms",
    "document-preview",
    "file-preview",
    "media",
    "payload",
    "payload-plugin",
    "payloadcms",
    "pdf",
    "plugin",
    "preview",
    "typescript",
    "video"
  ],
  "homepage": "https://github.com/maximseshuk/payload-plugin-media-preview#readme",
  "bugs": "https://github.com/maximseshuk/payload-plugin-media-preview/issues",
  "license": "MIT",
  "author": "Maxim Seshuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximseshuk/payload-plugin-media-preview.git"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/seshuk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./rsc": {
      "types": "./src/rsc/index.ts",
      "import": "./src/rsc/index.ts",
      "default": "./src/rsc/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js",
        "default": "./dist/client/index.js"
      },
      "./rsc": {
        "types": "./dist/rsc/index.d.ts",
        "import": "./dist/rsc/index.js",
        "default": "./dist/rsc/index.js"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "cross-env PAYLOAD_CONFIG_PATH=./tests/payload.config.ts DATABASE_URL=file:./tests/payload.db next dev tests --turbo",
    "dev:generate-importmap": "cd tests && cross-env PAYLOAD_CONFIG_PATH=./payload.config.ts payload generate:importmap",
    "dev:safe": "rm -rf tests/.next && cross-env PAYLOAD_CONFIG_PATH=./tests/payload.config.ts DATABASE_URL=file:./tests/payload.db next dev tests --turbo --port 3001",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run -c tests/vitest.config.ts",
    "test:coverage": "vitest run -c tests/vitest.config.ts --coverage",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "test:e2e:ui": "playwright test -c tests/playwright.config.ts --ui",
    "test:int": "vitest run -c tests/vitest.config.ts --project int",
    "test:unit": "vitest run -c tests/vitest.config.ts --project unit",
    "test:watch": "vitest -c tests/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@next/env": "^16.2.9",
    "@payloadcms/db-sqlite": "4.0.0-canary.37",
    "@payloadcms/next": "4.0.0-canary.37",
    "@payloadcms/translations": "4.0.0-canary.37",
    "@payloadcms/ui": "4.0.0-canary.37",
    "@playwright/test": "^1.60.0",
    "@seshuk/payload-plugin-tooling": "0.2.1",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "next": "16.2.9",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "payload": "4.0.0-canary.37",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "0.35.1",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@payloadcms/translations": "4.0.0-canary.37",
    "@payloadcms/ui": "4.0.0-canary.37",
    "payload": "4.0.0-canary.37"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
